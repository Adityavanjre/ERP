{
  "name": "klypso-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:agency": "concurrently \"npm run agency:server\" \"npm run agency:client\"",
    "agency:server": "cd agency/server && npm start",
    "agency:client": "cd agency/client && npm run dev",
    "start:nexus": "concurrently \"npm run nexus:backend\" \"npm run nexus:frontend\"",
    "nexus:backend": "cd nexus/backend && npm run start:dev",
    "nexus:frontend": "cd nexus/frontend && npm run dev",
    "start:all": "concurrently \"npm run start:agency\" \"npm run start:nexus\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/hpp": "^0.2.7",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-security": "^4.0.0",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.18",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "workspaces": [
    "nexus/backend",
    "nexus/frontend",
    "nexus/desktop",
    "agency/server",
    "agency/client",
    "gateway",
    "packages/*"
  ],
  "overrides": {
    "lodash": "^4.17.21",
    "cross-spawn": "^7.0.5",
    "path-to-regexp": "^6.3.0",
    "quill": "^1.3.7",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "ajv": "^8.18.0"
  }
}
