{
  "name": "klypso-ecosystem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:agency": "concurrently \"npm run agency:server\" \"npm run agency:client\"",
    "agency:server": "cd agency/server && npm start",
    "agency:client": "cd agency/client && npm run dev",
    "start:nexus": "concurrently \"npm run nexus:backend\" \"npm run nexus:frontend\"",
    "nexus:backend": "cd nexus/backend && npm run start:dev",
    "nexus:frontend": "cd nexus/frontend && npm run dev",
    "start:all": "concurrently \"npm run start:agency\" \"npm run start:nexus\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "pg": "^8.18.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ajv": "^8.18.0"
  },
  "workspaces": [
    "nexus/backend",
    "nexus/frontend",
    "nexus/desktop",
    "agency/server",
    "agency/client",
    "gateway",
    "packages/*"
  ],
  "overrides": {
    "lodash": "^4.17.21",
    "cross-spawn": "^7.0.5",
    "path-to-regexp": "^6.3.0",
    "quill": "^1.3.7"
  }
}
