# 🐘 Klypso Nexus Engine - Environment Blueprint

# 🛡️ Core Infrastructure
PORT=3001
NODE_ENV=development

# 🐘 Database (Prisma / Supabase)
# IMPORTANT: Override these with secure values in production!
# Generate with: openssl rand -hex 32 for secrets
DATABASE_URL="postgresql://admin:password@localhost:5432/nexus_db?schema=public"
DIRECT_URL="postgresql://admin:password@localhost:5432/nexus_db?schema=public"

# 🔐 Security Forensic
# Generate with: openssl rand -hex 32
JWT_SECRET="development-key-minimum-length-for-validation"
JWT_EXPIRES_IN="24h"

# 🌐 Gateway/Proxy Configuration
# The base path where the frontend is served (for redirects)
FRONTEND_URL="https://klypso.in/portal"
BACKEND_URL="https://klypso.in/portal/api"

# 📊 Analytics & Kernel
# Enable/Disable specific high-load aggregation services
KERNEL_STATS_ENABLED=true
AUDIT_LOG_LEVEL=verbose

# 🏢 Email Service (Internal Notifications)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=xxx

# 🚀 Performance
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
CACHE_MAX_ITEMS=1000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 🔐 MFA & Admin Security
# Generate with: openssl rand -base64 32 for MFA_ENCRYPTION_KEY
# Generate with: openssl rand -hex 32 for AUDIT_HMAC_SECRET
MFA_ENCRYPTION_KEY="development-mfa-encryption-key-32-chars"
ADMIN_PASSWORD="admin123456"
ADMIN_EMAIL="admin@klypso.in"
AUDIT_HMAC_SECRET="development-hmac-secret-32-chars-long"
RESEND_API_KEY="re_123456789"
