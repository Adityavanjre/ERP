# Nexus Desktop Environment Variables

# Frontend URL override.
# Leave empty to use the bundled local frontend server packaged inside the app.
# NEXUS_FRONTEND_URL=https://your-hostname/portal

# Backend base URL used by offline sync requests and web API calls
NEXUS_BACKEND_URL=http://127.0.0.1:3001

# Auto-start on login
AUTO_START=false

# Enable hardware acceleration
HW_ACCELERATION=true

# Offline mode
OFFLINE_MODE=false

# Window settings
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900

# Auto-update settings (reserved for future use)
AUTO_UPDATE=false
UPDATE_URL=
